{
	"name": "tsvsheet-obsidian",
	"version": "0.1.0",
	"description": "Obsidian plugin for tsvsheet — live ```sheet code blocks and an editable .tsvt view over the embedded WebAssembly engine.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"tsvsheet",
		"spreadsheet",
		"tsv",
		"wasm"
	],
	"author": "tsvsheet",
	"license": "MIT",
	"dependencies": {
		"@tsvsheet/tsvsheet": "file:../tsvsheet.js"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@types/node": "^22.10.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.18.0",
		"obsidian": "^1.7.2",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	}
}
