{
	"name": "tsvsheet-obsidian",
	"version": "0.3.0",
	"description": "Obsidian plugin for tsvsheet — live ```sheet code blocks and an editable .tsvt view over the embedded WebAssembly engine.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"stage": "cp node_modules/@tsvsheet/tsvsheet/src/tsvsheet/tsvsheet.wasm node_modules/@tsvsheet/tsvsheet/src/tsvsheet/wasm_exec.js .",
		"build": "npm run stage && tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "node --test"
	},
	"keywords": [
		"obsidian",
		"tsvsheet",
		"spreadsheet",
		"tsv",
		"wasm"
	],
	"author": "tsvsheet",
	"license": "MIT",
	"dependencies": {
		"@tsvsheet/tsvsheet": "file:../tsvsheet.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.10.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.25.0",
		"eslint": "^10.8.0",
		"happy-dom": "^20.11.0",
		"obsidian": "^1.7.2",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.65.0"
	}
}
